# Finança — Configuration d'Environnement Docker / VPS
# Copiez ce fichier vers .env sur votre serveur : cp .env.example .env

# Port d'écoute externe sur le VPS (ex: 4000 ou 8080)
PORT=4000

# Environnement Node.js
NODE_ENV=production

# Noms d'hôtes autorisés pour Angular SSR (protection SSRF).
# Utilisez '*' pour tout autoriser (si proxy Nginx/Caddy en amont),
# ou listez vos domaines séparés par des virgules (ex: "app.financa.com,localhost").
ALLOWED_HOSTS=*

# Nom et tag de l'image Docker
IMAGE_NAME=ghcr.io/centrafin/financa
IMAGE_TAG=latest
